# 実測・解析スクリプトの環境変数。`scripts/.env` にコピーして使う。
#
# ★ 全部空でも動く。**キーが無い機能だけがモックに落ちる**。
#   SNSのキーが無ければサンプル投稿を、GEMINI_API_KEY が無ければ
#   ルールベースの簡易解析を使い、パイプライン全体は同じ経路を通る。
#
#   例）キー無しで通しで動かす:
#     docker compose run --rm scripts python pipeline.py --source x --title-id t01
#
# ⚠️ モックに落ちた場合は [MOCK] と表示される。
#    その実行結果を精度・コストの実測値として扱わないこと。
#
# ⚠️ Webアプリ側の設定（AUTH_SECRET など）は web/.env.local に書く。

# --- X API ---------------------------------------------------------------
# Developer Portal > Projects & Apps > Keys and tokens > Bearer Token
X_BEARER_TOKEN=

# --- Instagram Graph API -------------------------------------------------
# Graph API Explorer で取得した長期アクセストークン
IG_ACCESS_TOKEN=
# 連携した Instagram ビジネス/クリエイターアカウントの ID（数字17桁程度）
IG_USER_ID=
# Graph API のバージョン（未設定なら v21.0）
IG_API_VERSION=v21.0

# --- Gemini --------------------------------------------------------------
# Google AI Studio で発行した API キー
GEMINI_API_KEY=
# モデルID。利用可能なモデルは AI Studio / `models.list` で確認すること
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 試算用パラメータ -----------------------------------------------------
USD_JPY=150
X_POST_READ_USD=0.005
