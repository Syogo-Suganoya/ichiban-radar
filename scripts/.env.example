# --- X API ---------------------------------------------------------------
# Developer Portal > Projects & Apps > Keys and tokens > Bearer Token
X_BEARER_TOKEN=

# --- Instagram Graph API -------------------------------------------------
# Graph API Explorer で取得した長期アクセストークン
IG_ACCESS_TOKEN=
# 連携した Instagram ビジネス/クリエイターアカウントの ID（数字17桁程度）
IG_USER_ID=
# Graph API のバージョン（未設定なら v21.0）
IG_API_VERSION=v21.0

# --- Gemini --------------------------------------------------------------
# Google AI Studio で発行した API キー
GEMINI_API_KEY=
# モデルID。利用可能なモデルは AI Studio / `models.list` で確認すること
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 試算用パラメータ -----------------------------------------------------
USD_JPY=150
X_POST_READ_USD=0.005
